# AI model
API_KEY=
MODEL_NAME=
API_URL=
LLM_PRACTICE_ENABLED=true
PLANNER_MODEL=
EXTRACT_MODEL=
EMBEDDING_MODEL=

# Infrastructure
SQL_DATABASE_URL=mysql+asyncmy://user:password@127.0.0.1:3306/zhixueban
REDIS_URL=redis://127.0.0.1:6379/0
CHROMA_PERSIST_DIR=./chroma_db
APP_DEBUG=false
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=900
DB_POOL_PRE_PING=true
DB_CONNECT_TIMEOUT_SECONDS=5

# Authentication: generate a unique random value with at least 32 characters
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Alipay sandbox (local development uses synchronous return + active query)
ALIPAY_APP_ID=
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_PRIVATE_KEY_PATH=backend/secrets/alipay_app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=backend/secrets/alipay_public_key.pem
ALIPAY_RETURN_URL=http://127.0.0.1:5173/payment/result
# Leave empty until the backend has a public HTTPS address.
# Example: https://your-public-host.example/vip/alipay/notify
ALIPAY_NOTIFY_URL=
